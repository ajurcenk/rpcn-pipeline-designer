{
  "name": "rpcn-spike-assistant-host",
  "displayName": "Spike 65: assistant host (never shipped)",
  "description": "Throwaway spike extension: embeds the Claude Agent SDK in the extension host, through the Redpanda ADP proxy. Not part of the Pipeline Designer; never packaged with it.",
  "version": "0.0.0",
  "publisher": "ajurcenk",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rpcnSpike.runAssistant",
        "title": "Spike: run the assistant"
      }
    ],
    "configuration": {
      "title": "Spike 65",
      "properties": {
        "rpcnSpike.auth": {
          "type": "string",
          "enum": [
            "x-api-key",
            "bearer"
          ],
          "default": "x-api-key",
          "description": "How the SDK sends the ADP key: x-api-key (ANTHROPIC_API_KEY) or a bearer token (ANTHROPIC_AUTH_TOKEN). Set it to what the contract probe found working."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.329",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.100.0",
    "typescript": "~6.0.3"
  }
}
