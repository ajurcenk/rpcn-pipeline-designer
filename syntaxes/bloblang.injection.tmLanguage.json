{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"scopeName": "bloblang.injection",
	"comment": "Injected into YAML (AD-14, ticket 2.9): Bloblang in the values of Redpanda Connect mapping fields, and in ${! } interpolations anywhere in YAML strings. VS Code's YAML grammar consumes each line's indentation (and a sequence dash) with its own while rules before injections run, so a key is matched where it starts, and a block scalar ends where the remaining text starts without extra indentation (a sibling key or the next item). The key list holds only field names that are Bloblang in every component of the 4.112.0 docs and specific to Redpanda Connect: injections apply to every YAML file, so generic words such as when, variables or history are left out.",
	"injectionSelector": "L:source.yaml -comment -source.bloblang, L:source.yaml.1.3 -comment -source.bloblang, L:source.yaml.1.2 -comment -source.bloblang, L:source.yaml.1.1 -comment -source.bloblang, L:source.yaml.1.0 -comment -source.bloblang",
	"patterns": [
		{
			"include": "#block"
		},
		{
			"include": "#single-quoted"
		},
		{
			"include": "#double-quoted"
		},
		{
			"include": "#plain"
		},
		{
			"include": "#interpolation"
		}
	],
	"repository": {
		"block": {
			"begin": "(?<![^\\s-])((?:application_properties_map|args_mapping|bloblang|check|document_map|extract_tracing_map|fields_mapping|filter_map|hint_map|inject_tracing_map|keys_mapping|mapping|metadata_mapping|mutation|new_column_type_mapping|open_message_mapping|partition_keys_map|payload_mapping|request_map|result_map|skip_on|tags_mapping|text_mapping|timestamp_mapping|value_map|vector_mapping))\\s*(:)\\s+[|>][-+0-9]*\\s*(?:#.*)?$",
			"end": "(?:^|\\G)(?=\\S)",
			"beginCaptures": {
				"1": {
					"name": "entity.name.tag.yaml"
				},
				"2": {
					"name": "punctuation.separator.key-value.mapping.yaml"
				}
			},
			"contentName": "meta.embedded.block.bloblang source.bloblang",
			"patterns": [
				{
					"include": "source.bloblang"
				}
			]
		},
		"single-quoted": {
			"begin": "(?<![^\\s-])((?:application_properties_map|args_mapping|bloblang|check|document_map|extract_tracing_map|fields_mapping|filter_map|hint_map|inject_tracing_map|keys_mapping|mapping|metadata_mapping|mutation|new_column_type_mapping|open_message_mapping|partition_keys_map|payload_mapping|request_map|result_map|skip_on|tags_mapping|text_mapping|timestamp_mapping|value_map|vector_mapping))\\s*(:)\\s+(')",
			"end": "'(?!')",
			"beginCaptures": {
				"1": {
					"name": "entity.name.tag.yaml"
				},
				"2": {
					"name": "punctuation.separator.key-value.mapping.yaml"
				},
				"3": {
					"name": "punctuation.definition.string.begin.yaml"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.string.end.yaml"
				}
			},
			"contentName": "meta.embedded.inline.bloblang source.bloblang",
			"patterns": [
				{
					"match": "''",
					"name": "constant.character.escape.yaml"
				},
				{
					"include": "source.bloblang"
				}
			]
		},
		"double-quoted": {
			"begin": "(?<![^\\s-])((?:application_properties_map|args_mapping|bloblang|check|document_map|extract_tracing_map|fields_mapping|filter_map|hint_map|inject_tracing_map|keys_mapping|mapping|metadata_mapping|mutation|new_column_type_mapping|open_message_mapping|partition_keys_map|payload_mapping|request_map|result_map|skip_on|tags_mapping|text_mapping|timestamp_mapping|value_map|vector_mapping))\\s*(:)\\s+(\")",
			"end": "\"",
			"beginCaptures": {
				"1": {
					"name": "entity.name.tag.yaml"
				},
				"2": {
					"name": "punctuation.separator.key-value.mapping.yaml"
				},
				"3": {
					"name": "punctuation.definition.string.begin.yaml"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.string.end.yaml"
				}
			},
			"contentName": "meta.embedded.inline.bloblang source.bloblang",
			"patterns": [
				{
					"match": "\\\\.",
					"name": "constant.character.escape.yaml"
				},
				{
					"include": "source.bloblang"
				}
			]
		},
		"plain": {
			"match": "(?<![^\\s-])((?:application_properties_map|args_mapping|bloblang|check|document_map|extract_tracing_map|fields_mapping|filter_map|hint_map|inject_tracing_map|keys_mapping|mapping|metadata_mapping|mutation|new_column_type_mapping|open_message_mapping|partition_keys_map|payload_mapping|request_map|result_map|skip_on|tags_mapping|text_mapping|timestamp_mapping|value_map|vector_mapping))\\s*(:)\\s+(?![|>'\"\\s])(.*?)(\\s+#.*)?$",
			"captures": {
				"1": {
					"name": "entity.name.tag.yaml"
				},
				"2": {
					"name": "punctuation.separator.key-value.mapping.yaml"
				},
				"3": {
					"name": "meta.embedded.inline.bloblang source.bloblang",
					"patterns": [
						{
							"include": "source.bloblang"
						}
					]
				},
				"4": {
					"name": "comment.line.number-sign.yaml"
				}
			}
		},
		"interpolation": {
			"name": "meta.interpolation.bloblang",
			"begin": "\\$\\{!",
			"end": "\\}",
			"beginCaptures": {
				"0": {
					"name": "punctuation.section.interpolation.begin.bloblang"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.section.interpolation.end.bloblang"
				}
			},
			"contentName": "source.bloblang",
			"patterns": [
				{
					"include": "source.bloblang"
				}
			]
		}
	}
}
