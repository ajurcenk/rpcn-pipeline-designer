# Graph records hold UTF-16 offsets into the YAML as committed; a CRLF checkout would shift them.
test/corpus/*.yaml text eol=lf
test/corpus/*.graph/*.json text eol=lf
# Bloblang records hold raw binary output; the samples feed it byte for byte.
test/corpus/*.bloblang/*.json text eol=lf
test/corpus/*.samples.json text eol=lf
test/corpus/fixtures/*.bloblang/*.json text eol=lf
test/corpus/fixtures/*.samples.json text eol=lf
src/test/fixtures/models/*.yaml text eol=lf
src/test/fixtures/models/*.json text eol=lf
