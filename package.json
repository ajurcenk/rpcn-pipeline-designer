{
  "name": "rpcn-pipeline-designer",
  "displayName": "Pipeline Designer for Redpanda Connect",
  "description": "Pipeline graph, Redpanda Connect-aware YAML editing and local runs for Redpanda Connect configs.",
  "version": "0.0.1",
  "publisher": "ajurcenk",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajurcenk/rpcn-pipeline-designer"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "redpanda",
    "redpanda connect",
    "benthos",
    "yaml",
    "pipeline"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Redpanda Connect",
      "properties": {
        "redpandaConnect.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Fallback path to the `redpanda-connect` or `rpk` binary. `PATH` is tried first (`rpk connect`, then `redpanda-connect`); this setting is used only when neither is usable. `~` expands to the home directory (on Linux and macOS, `~user` to that user's), a relative path resolves against the first workspace folder, and a bare name is looked up on `PATH`."
        },
        "redpandaConnect.autoOpenGraph": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open the pipeline graph beside a detected Redpanda Connect config the first time an editor shows it in a window session. **Hide graph** turns this off for one file until **Show graph**."
        },
        "redpandaConnect.filePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns of files that are always treated as Redpanda Connect configs, templates included. A pattern matches relative to the workspace folder that contains the file, or against the file's absolute path: `*.rpcn.yaml` matches only at a workspace-folder root, `**/*.rpcn.yaml` anywhere."
        },
        "redpandaConnect.resourceFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Resource files passed to lint and run with `--resources` (each entry may be a glob pattern). `~` expands to the home directory (on Linux and macOS, `~user` to that user's); a relative path resolves against the workspace folder whose settings set it, else the first workspace folder, and with no workspace folder open it is rejected and lint and run do not start."
        },
        "redpandaConnect.envFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Environment file passed to lint, run and the Bloblang checks (live errors and the test panel) with `--env-file`. `~` expands to the home directory (on Linux and macOS, `~user` to that user's); a relative path resolves against the workspace folder whose settings set it, else the first workspace folder, and with no workspace folder open it is rejected and lint and run do not start."
        },
        "redpandaConnect.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "resource",
          "markdownDescription": "Environment variables for lint, run and the Bloblang checks (live errors and the test panel), as `\"NAME\": \"value\"` pairs that `${NAME}` in a config reads. They win over `#redpandaConnect.envFile#` and over the environment VS Code was started with. User, workspace and folder values merge by name, the most specific winning. A name must match `[A-Za-z_][A-Za-z0-9_]*` and a value be a string; others are left out (and logged). The values are passed in an owner-only file in the extension's storage, but they are plain text in `settings.json`: keep secrets in the env file or in `#redpandaConnect.secretEnv#`."
        },
        "redpandaConnect.secretEnv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Names of secret environment variables for lint, run and the Bloblang checks (live errors and the test panel). Only the names are here, so this is safe to commit; the values are kept in VS Code's secret storage on this machine, per workspace folder, and set with **Redpanda Connect: Set secret variable** (which also adds the name here). They reach the binary in its process environment only, so `#redpandaConnect.env#` and `#redpandaConnect.envFile#` win for the same name. A name must match `[A-Za-z_][A-Za-z0-9_]*`. User, workspace and folder lists do not merge: the most specific list is used."
        }
      }
    },
    "commands": [
      {
        "command": "redpandaConnect.showGraph",
        "title": "Show graph",
        "category": "Redpanda Connect",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "redpandaConnect.hideGraph",
        "title": "Hide graph",
        "category": "Redpanda Connect",
        "icon": "$(eye-closed)"
      },
      {
        "command": "redpandaConnect.run",
        "title": "Run",
        "category": "Redpanda Connect",
        "icon": "$(play)"
      },
      {
        "command": "redpandaConnect.stop",
        "title": "Stop",
        "category": "Redpanda Connect",
        "icon": "$(debug-stop)"
      },
      {
        "command": "redpandaConnect.runUntitled",
        "title": "Save the file to run it.",
        "category": "Redpanda Connect",
        "icon": "$(play)",
        "enablement": "false"
      },
      {
        "command": "redpandaConnect.refreshSchema",
        "title": "Refresh Schema",
        "category": "Redpanda Connect"
      },
      {
        "command": "redpandaConnect.testMapping",
        "title": "Test mapping",
        "category": "Redpanda Connect"
      },
      {
        "command": "redpandaConnect.setSecret",
        "title": "Set secret variable",
        "category": "Redpanda Connect"
      },
      {
        "command": "redpandaConnect.removeSecret",
        "title": "Remove secret variable",
        "category": "Redpanda Connect"
      },
      {
        "command": "redpandaConnect.clearSecrets",
        "title": "Clear stored secrets",
        "category": "Redpanda Connect"
      },
      {
        "command": "redpandaConnect.environment.add",
        "title": "Add variable",
        "category": "Redpanda Connect",
        "icon": "$(add)"
      },
      {
        "command": "redpandaConnect.environment.edit",
        "title": "Edit value",
        "category": "Redpanda Connect",
        "icon": "$(edit)"
      },
      {
        "command": "redpandaConnect.environment.remove",
        "title": "Remove",
        "category": "Redpanda Connect",
        "icon": "$(trash)"
      },
      {
        "command": "redpandaConnect.environment.showValue",
        "title": "Show value",
        "category": "Redpanda Connect",
        "icon": "$(eye)"
      },
      {
        "command": "redpandaConnect.environment.hideValue",
        "title": "Hide value",
        "category": "Redpanda Connect",
        "icon": "$(eye-closed)"
      },
      {
        "command": "redpandaConnect.environment.openEnvFile",
        "title": "Open env file",
        "category": "Redpanda Connect",
        "icon": "$(go-to-file)"
      },
      {
        "command": "redpandaConnect.environment.refresh",
        "title": "Refresh",
        "category": "Redpanda Connect",
        "icon": "$(refresh)"
      },
      {
        "command": "redpandaConnect.setMissingVariable",
        "title": "Set variable",
        "category": "Redpanda Connect",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "redpandaConnect.showGraph",
          "when": "redpandaConnect.activeEditorDetected && resourcePath not in redpandaConnect.graphOpenPaths"
        },
        {
          "command": "redpandaConnect.hideGraph",
          "when": "redpandaConnect.activeEditorDetected && resourcePath in redpandaConnect.graphOpenPaths || activeWebviewPanelId == 'redpandaConnect.graph'"
        },
        {
          "command": "redpandaConnect.run",
          "when": "redpandaConnect.activeEditorDetected"
        },
        {
          "command": "redpandaConnect.stop",
          "when": "redpandaConnect.activeEditorRunning"
        },
        {
          "command": "redpandaConnect.runUntitled",
          "when": "false"
        },
        {
          "command": "redpandaConnect.testMapping",
          "when": "editorLangId == yaml"
        },
        {
          "command": "redpandaConnect.setSecret"
        },
        {
          "command": "redpandaConnect.removeSecret"
        },
        {
          "command": "redpandaConnect.clearSecrets"
        },
        {
          "command": "redpandaConnect.environment.add",
          "when": "false"
        },
        {
          "command": "redpandaConnect.environment.edit",
          "when": "false"
        },
        {
          "command": "redpandaConnect.environment.remove",
          "when": "false"
        },
        {
          "command": "redpandaConnect.environment.showValue",
          "when": "false"
        },
        {
          "command": "redpandaConnect.environment.hideValue",
          "when": "false"
        },
        {
          "command": "redpandaConnect.environment.openEnvFile",
          "when": "false"
        },
        {
          "command": "redpandaConnect.environment.refresh",
          "when": "false"
        },
        {
          "command": "redpandaConnect.setMissingVariable",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "redpandaConnect.run",
          "when": "resourceScheme != untitled && resourcePath in redpandaConnect.detectedPaths",
          "group": "navigation"
        },
        {
          "command": "redpandaConnect.runUntitled",
          "when": "resourceScheme == untitled && resourcePath in redpandaConnect.detectedPaths",
          "group": "navigation"
        },
        {
          "command": "redpandaConnect.showGraph",
          "when": "resourcePath in redpandaConnect.detectedPaths && resourcePath not in redpandaConnect.graphOpenPaths",
          "group": "navigation"
        },
        {
          "command": "redpandaConnect.hideGraph",
          "when": "resourcePath in redpandaConnect.detectedPaths && resourcePath in redpandaConnect.graphOpenPaths",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "redpandaConnect.environment.add",
          "when": "view == redpandaConnect.environment",
          "group": "navigation@1"
        },
        {
          "command": "redpandaConnect.environment.openEnvFile",
          "when": "view == redpandaConnect.environment",
          "group": "navigation@2"
        },
        {
          "command": "redpandaConnect.environment.refresh",
          "when": "view == redpandaConnect.environment",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "redpandaConnect.setMissingVariable",
          "when": "view == redpandaConnect.environment && viewItem =~ /^missing$/",
          "group": "inline"
        },
        {
          "command": "redpandaConnect.environment.showValue",
          "when": "view == redpandaConnect.environment && viewItem =~ /\\bmasked\\b/",
          "group": "inline"
        },
        {
          "command": "redpandaConnect.environment.hideValue",
          "when": "view == redpandaConnect.environment && viewItem =~ /\\brevealed\\b/",
          "group": "inline"
        },
        {
          "command": "redpandaConnect.environment.edit",
          "when": "view == redpandaConnect.environment && viewItem =~ /^variable (plain|secret)\\b/",
          "group": "inline"
        },
        {
          "command": "redpandaConnect.environment.remove",
          "when": "view == redpandaConnect.environment && viewItem =~ /^variable (plain\\b|secret hasValue\\b)/",
          "group": "inline"
        },
        {
          "command": "redpandaConnect.environment.openEnvFile",
          "when": "view == redpandaConnect.environment && viewItem =~ /\\benvFileSet\\b/",
          "group": "inline"
        },
        {
          "command": "redpandaConnect.setMissingVariable",
          "when": "view == redpandaConnect.environment && viewItem =~ /^missing$/",
          "group": "1_actions@1"
        },
        {
          "command": "redpandaConnect.environment.showValue",
          "when": "view == redpandaConnect.environment && viewItem =~ /\\bmasked\\b/",
          "group": "1_actions@2"
        },
        {
          "command": "redpandaConnect.environment.hideValue",
          "when": "view == redpandaConnect.environment && viewItem =~ /\\brevealed\\b/",
          "group": "1_actions@2"
        },
        {
          "command": "redpandaConnect.environment.edit",
          "when": "view == redpandaConnect.environment && viewItem =~ /^variable (plain|secret)\\b/",
          "group": "1_actions@3"
        },
        {
          "command": "redpandaConnect.environment.remove",
          "when": "view == redpandaConnect.environment && viewItem =~ /^variable (plain\\b|secret hasValue\\b)/",
          "group": "1_actions@4"
        },
        {
          "command": "redpandaConnect.environment.openEnvFile",
          "when": "view == redpandaConnect.environment && viewItem =~ /\\benvFileSet\\b/",
          "group": "1_actions@5"
        }
      ]
    },
    "grammars": [
      {
        "scopeName": "source.bloblang",
        "path": "./syntaxes/bloblang.tmLanguage.json"
      },
      {
        "scopeName": "bloblang.injection",
        "path": "./syntaxes/bloblang.injection.tmLanguage.json",
        "injectTo": [
          "source.yaml",
          "source.yaml.1.3",
          "source.yaml.1.2",
          "source.yaml.1.1",
          "source.yaml.1.0"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "redpandaConnect",
          "title": "Redpanda Connect",
          "icon": "media/redpanda-connect.svg"
        }
      ]
    },
    "views": {
      "redpandaConnect": [
        {
          "id": "redpandaConnect.environment",
          "name": "Environment",
          "contextualTitle": "Redpanda Connect",
          "icon": "media/redpanda-connect.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && node scripts/clean-test-storage.mjs && npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit && tsc -p test/corpus/tsconfig.json && tsc -p webview/tsconfig.json && tsc -p webview/tsconfig.test.json",
    "lint": "eslint src webview test/corpus vitest.config.mts",
    "test": "vscode-test",
    "test:corpus": "vitest run --config vitest.config.mts",
    "test:corpus:record": "vitest run --config vitest.config.mts --mode record",
    "test:webview": "vitest run --config webview/vitest.config.mts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.5.0",
    "happy-dom": "20.14.5",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "5.0.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6",
    "vitest": {
      "@types/node": "$@types/node"
    }
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  }
}
